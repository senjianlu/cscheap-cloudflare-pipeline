{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "site.json(使用方配置)",
  "description": "内容契约 v1。由 contract/ 经 scripts/gen-schemas.ts 生成,请勿手改。",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "locales": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 35,
        "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?(-([a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*$"
      },
      "uniqueItems": true
    },
    "defaultLocale": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?(-([a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*$"
    },
    "channels": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,31}$"
      },
      "additionalProperties": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "draft",
            "reviewed",
            "published",
            "held",
            "retired"
          ]
        },
        "uniqueItems": true
      },
      "minProperties": 1
    },
    "actors": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,31}$"
      },
      "uniqueItems": true
    },
    "types": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "blog.post",
          "wiki.site",
          "wiki.event",
          "wiki.guide",
          "docs.page",
          "docs.api"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "urlPattern": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^(\\/([a-z0-9]+(-[a-z0-9]+)*|\\{(locale|slug|id)\\}))+$"
          }
        },
        "required": [
          "urlPattern"
        ],
        "additionalProperties": false
      },
      "minProperties": 1
    },
    "assetHosts": {
      "default": [],
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
      },
      "uniqueItems": true
    },
    "specs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?(-([a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(?!\\.{1,2}(\\/|$))[A-Za-z0-9._-]+(\\/(?!\\.{1,2}(\\/|$))[A-Za-z0-9._-]+)*$"
        },
        "minProperties": 1
      }
    }
  },
  "required": [
    "source",
    "locales",
    "defaultLocale",
    "channels",
    "actors",
    "types"
  ],
  "additionalProperties": false
}
