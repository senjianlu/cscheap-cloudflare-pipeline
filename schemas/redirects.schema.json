{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "redirects.json(重定向)",
  "description": "内容契约 v1。由 contract/ 经 scripts/gen-schemas.ts 生成,请勿手改。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "redirects": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^\\/(?!\\/)"
          },
          "to": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^\\/(?!\\/)"
          },
          "status": {
            "anyOf": [
              {
                "type": "number",
                "const": 301
              },
              {
                "type": "number",
                "const": 308
              }
            ]
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?(-([a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*$"
          }
        },
        "required": [
          "from",
          "to",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "redirects"
  ],
  "additionalProperties": false
}
