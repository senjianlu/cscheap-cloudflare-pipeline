{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "item.json(wiki.event)",
  "description": "内容契约 v1。由 contract/ 经 scripts/gen-schemas.ts 生成,请勿手改。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "published",
        "held",
        "retired"
      ]
    },
    "workflow": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "draft",
              "reviewed",
              "published",
              "held",
              "retired"
            ]
          },
          "by": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "at": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "stage",
          "by",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "publishedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "authors": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "sources": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "url"
              },
              "url": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^https?:\\/\\/[^\\s/]"
              },
              "retrievedAt": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
              }
            },
            "required": [
              "kind",
              "url"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "project"
              },
              "id": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "category": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "tags": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "refs": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rel": {
            "type": "string",
            "enum": [
              "about",
              "mentions",
              "related",
              "partOf",
              "supersedes"
            ]
          },
          "target": {
            "type": "string",
            "maxLength": 400,
            "pattern": "^(?:blog\\.post:[a-z0-9]+(?:[._-][a-z0-9]+)*|wiki\\.site:[a-z0-9]+(?:[._-][a-z0-9]+)*|wiki\\.event:[a-z0-9]+(?:[._-][a-z0-9]+)*|wiki\\.guide:[a-z0-9]+(?:[._-][a-z0-9]+)*|docs\\.page:[a-z0-9]+(?:[._-][a-z0-9]+)*|docs\\.api:[a-z0-9]+(?:[._-][a-z0-9]+)*|item:[a-z0-9]+(?:-[a-z0-9]+)*\\/(?:[A-Za-z0-9._~-]|%[0-9A-F]{2}){1,256})$"
          }
        },
        "required": [
          "rel",
          "target"
        ],
        "additionalProperties": false
      }
    },
    "icon": {
      "anyOf": [
        {
          "type": "boolean",
          "const": false
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "type": "object",
          "properties": {
            "image": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^(?:https:\\/\\/[^\\s/].*|(?!\\.{1,2}(\\/|$))[A-Za-z0-9._-]+(\\/(?!\\.{1,2}(\\/|$))[A-Za-z0-9._-]+)*)$"
            },
            "imageDark": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^(?:https:\\/\\/[^\\s/].*|(?!\\.{1,2}(\\/|$))[A-Za-z0-9._-]+(\\/(?!\\.{1,2}(\\/|$))[A-Za-z0-9._-]+)*)$"
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          },
          "required": [
            "image"
          ],
          "additionalProperties": false
        }
      ]
    },
    "seo": {
      "type": "object",
      "properties": {
        "noindex": {
          "type": "boolean"
        },
        "canonical": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:\\/(?!\\/)|https:\\/\\/[^\\s/])"
        },
        "ogImage": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:https:\\/\\/[^\\s/].*|(?!\\.{1,2}(\\/|$))[A-Za-z0-9._-]+(\\/(?!\\.{1,2}(\\/|$))[A-Za-z0-9._-]+)*)$"
        }
      },
      "additionalProperties": false
    },
    "type": {
      "type": "string",
      "const": "wiki.event"
    },
    "data": {
      "type": "object",
      "properties": {
        "eventKind": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "startDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "endDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "datePrecision": {
          "type": "string",
          "enum": [
            "day",
            "month",
            "year"
          ]
        },
        "officialUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?:\\/\\/[^\\s/]"
        },
        "location": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "address": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "name",
            "address"
          ],
          "additionalProperties": false
        },
        "organizer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "eventKind",
        "startDate"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "stage",
    "workflow",
    "type",
    "data"
  ],
  "additionalProperties": false
}
