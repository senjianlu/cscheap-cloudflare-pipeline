{
  "name": "cscheap-cloudflare-pipeline",
  "version": "0.0.0",
  "private": true,
  "description": "把 Git 仓库里的结构化内容发布到 Cloudflare D1 / R2 的内容管线:内容契约、命令行与可复用工作流",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schemas",
    "migrations",
    "templates"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc contract/index.ts --outDir dist --rootDir contract --declaration --module nodenext --moduleResolution nodenext --target es2022 --lib es2023 --strict --noUncheckedIndexedAccess --rewriteRelativeImportExtensions --verbatimModuleSyntax --skipLibCheck",
    "prepare": "node --run build",
    "lint": "eslint . && prettier --check \"contract/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"*.{ts,mjs}\" package.json tsconfig.json",
    "format": "prettier --write \"contract/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"*.{ts,mjs}\" package.json tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:static": "pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "gen:schemas": "node scripts/gen-schemas.ts",
    "check:schemas": "bash scripts/check-schemas.sh",
    "smoke:consumer": "bash scripts/smoke-consumer.sh"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "miniflare": "4.20260730.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
